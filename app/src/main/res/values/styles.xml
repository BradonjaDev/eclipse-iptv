<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#070507</color>
    <color name="accent">#DD1A34</color>

    <style name="App" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
    </style>
</resources>
